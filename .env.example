# Copy to .env and tweak for local runs (the agent reads these at startup).
# Where Ollama is listening.
OLLAMA_HOST=http://localhost:11434
# Local model — keep it small so it runs on a laptop. Must support tool calls.
AISEC_MODEL=llama3.2:3b
# off|on — the whole point of the lab. off = vulnerable, on = defended.
GUARDRAILS=off
# Deterministic by default so the before/after comparison is stable.
AISEC_TEMPERATURE=0.0
